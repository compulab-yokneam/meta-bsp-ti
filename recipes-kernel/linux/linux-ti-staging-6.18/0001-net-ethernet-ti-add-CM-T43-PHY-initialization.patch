new file mode 100644
index 000000000000..b8e5fe8af5ef
--- /dev/null
+++ b/drivers/net/ethernet/ti/davinci_mdio_cm_t43.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __DAVINCI_MDIO_CM_T43_H__
+#define __DAVINCI_MDIO_CM_T43_H__
+
+struct device;
+
+int davinci_mdio_cm_t43_enable_phys(struct device *dev);
+
+#endif /* __DAVINCI_MDIO_CM_T43_H__ */
