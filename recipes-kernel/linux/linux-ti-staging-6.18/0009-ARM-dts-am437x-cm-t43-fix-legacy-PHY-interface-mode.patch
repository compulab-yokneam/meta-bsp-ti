From 54bdf0cfb2fa542b601e59969217dfe36b610d01 Mon Sep 17 00:00:00 2001
From: Valentin Raevsky <valentin@compulab.co.il>
Date: Fri, 4 Sep 2026 19:55:54 +0000
Subject: [PATCH] ARM: dts: am437x-cm-t43: fix legacy PHY interface mode

The legacy CM-T43 variant uses Atheros PHYs at MDIO addresses 0 and 1.
Remove its rgmii-txid overrides from both CPSW ports. The base CM-T43 DTS
already selects rgmii-id, so the legacy variant inherits the required
receive and transmit clock delays while only replacing the PHY handles.

Upstream-Status: Pending
Signed-off-by: Valentin Raevsky <valentin@compulab.co.il>
---
 arch/arm/boot/dts/ti/omap/am437x-cm-t43-legacy-phy.dtsi | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm/boot/dts/ti/omap/am437x-cm-t43-legacy-phy.dtsi b/arch/arm/boot/dts/ti/omap/am437x-cm-t43-legacy-phy.dtsi
index f78bf68a4114..4f1889ce82c6 100644
--- a/arch/arm/boot/dts/ti/omap/am437x-cm-t43-legacy-phy.dtsi
+++ b/arch/arm/boot/dts/ti/omap/am437x-cm-t43-legacy-phy.dtsi
@@ -28,10 +28,8 @@ legacy_ethphy1: ethernet-phy@1 {
 
 &cpsw_port1 {
 	phy-handle = <&legacy_ethphy0>;
-	phy-mode = "rgmii-txid";
 };
 
 &cpsw_port2 {
 	phy-handle = <&legacy_ethphy1>;
-	phy-mode = "rgmii-txid";
 };
-- 
2.43.0

